generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  CLOSED
  BLOCKED
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  CLOSED
  OVERDUE
  REJECTED
}

enum PaymentFrequency {
  WEEKLY
  MONTHLY
}

enum PaymentStatus {
  PAID
  PENDING
  LATE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

enum ExpenseCategory {
  OFFICE
  SALARY
  PETROL
  ELECTRICITY
  RENT
  OTHER
}

enum EodStatus {
  PENDING
  REJECTED
  CLOSED
}

// ================= ADMIN =================

model Admin {
  id String @id @default(uuid())

  name String @db.VarChar(100)

  email String @unique @db.VarChar(150)

  password String @db.VarChar(255)

  role AdminRole @default(SUPER_ADMIN)

  isActive Boolean @default(true)

  auditLogs AuditLog[]

  notifications Notification[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ================= PARTNER =================

model Partner {
  id String @id @default(uuid())

  partnerCode String @unique @db.VarChar(20)

  // Prefix used to auto-generate this partner's own customer codes
  // (e.g. "P" -> PCUS001, PCUS002, ...). nextCustomerSeq only ever
  // increments, so a deleted/blocked customer's number is never reused.
  customerCodePrefix String? @unique @db.VarChar(10)

  nextCustomerSeq Int @default(1)

  name String @db.VarChar(100)

  phone String @unique @db.VarChar(15)

  email String? @unique @db.VarChar(150)

  password String?

  address String? @db.Text

  profilePicture String? @db.Text

  investmentAmount Decimal @db.Decimal(15, 2)

  currentBalance Decimal @db.Decimal(15, 2)

  status PartnerStatus @default(ACTIVE)

  loans Loan[]

  customers Customer[]

  expenses Expense[]

  eodReports EodReport[]

  notifications Notification[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("partners")
}

// ================= CUSTOMER =================

model Customer {
  id String @id @default(uuid())

  // Uniqueness for customerCode/phone/aadhaarNumber/panNumber is enforced only
  // among ACTIVE customers via partial unique indexes (see migration
  // 20260911_customer_active_unique_indexes) rather than a blanket @unique,
  // so a BLOCKED/CLOSED customer's identity fields can be reused.
  customerCode String @db.VarChar(20)

  name String @db.VarChar(100)

  phone String @db.VarChar(15)

  alternatePhone String? @db.VarChar(15)

  aadhaarNumber String? @db.VarChar(20)

  panNumber String? @db.VarChar(20)

  address String? @db.Text

  city String? @db.VarChar(100)

  state String? @db.VarChar(100)

  pincode String? @db.VarChar(10)

  guarantorName String? @db.VarChar(100)

  guarantorPhone String? @db.VarChar(15)

  status CustomerStatus @default(ACTIVE)

  partnerId String?

  partner Partner? @relation(fields: [partnerId], references: [id])

  loans Loan[]

  notifications Notification[]

  documents CustomerDocument[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([customerCode])
  @@index([aadhaarNumber])
  @@index([panNumber])
  @@index([partnerId])
  @@map("customers")
}

// ================= LOAN =================

model Loan {
  id String @id @default(uuid())

  loanNumber String @unique @db.VarChar(30)

  customerId String

  partnerId String

  customer Customer @relation(fields: [customerId], references: [id])

  partner Partner @relation(fields: [partnerId], references: [id])

  principalAmount Decimal @db.Decimal(15, 2)

  interestPercentage Decimal @db.Decimal(5, 2)

  interestAmount Decimal @db.Decimal(15, 2)

  totalPayable Decimal @db.Decimal(15, 2)

  balanceAmount Decimal @db.Decimal(15, 2)

  paymentFrequency PaymentFrequency

  duration Int

  installmentAmount Decimal @db.Decimal(15, 2)

  paidInstallments Int @default(0)

  totalInstallments Int

  penaltyPercentage Decimal? @db.Decimal(5, 2)

  penaltyAmount Decimal? @db.Decimal(15, 2)

  status LoanStatus @default(PENDING)

  approvedBy String?

  approvedAt DateTime?

  startDate DateTime?

  endDate DateTime?

  remarks String? @db.Text

  rejectionReason String? @db.Text

  payments Payment[]

  schedules LoanSchedule[]

  notifications Notification[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([partnerId])
  @@map("loans")
}

// ================= PAYMENT =================

model Payment {
  id String @id @default(uuid())

  receiptNumber String @unique @db.VarChar(30)

  loanId String

  scheduleId String?

  loan Loan @relation(fields: [loanId], references: [id])

  schedule LoanSchedule? @relation(fields: [scheduleId], references: [id])

  installmentNumber Int

  amount Decimal @db.Decimal(15, 2)

  penalty Decimal @default(0) @db.Decimal(15, 2)

  totalReceived Decimal @db.Decimal(15, 2)

  paymentMethod PaymentMethod

  paymentStatus PaymentStatus @default(PENDING)

  paidAt DateTime?

  remarks String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([loanId])
  @@map("payments")
}

// ================= EXPENSE =================

model Expense {
  id String @id @default(uuid())

  partnerId String

  partner Partner @relation(fields: [partnerId], references: [id])

  category ExpenseCategory

  amount Decimal @db.Decimal(15, 2)

  description String? @db.Text

  expenseDate DateTime

  createdAt DateTime @default(now())

  @@map("expenses")
}

// ================= EOD REPORT =================

model EodReport {
  id String @id @default(uuid())

  partnerId String

  partner Partner @relation(fields: [partnerId], references: [id])

  reportDate DateTime

  totalCollection Decimal @db.Decimal(15, 2)

  totalExpenses Decimal @db.Decimal(15, 2)

  netRemittance Decimal @db.Decimal(15, 2)

  status EodStatus @default(PENDING)

  rejectionReason String? @db.Text

  approvedBy String?

  approvedAt DateTime?

  expenses EodExpense[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([partnerId, reportDate])
  @@index([partnerId])
  @@map("eod_reports")
}

model EodExpense {
  id String @id @default(uuid())

  eodReportId String

  eodReport EodReport @relation(fields: [eodReportId], references: [id], onDelete: Cascade)

  category ExpenseCategory

  amount Decimal @db.Decimal(15, 2)

  description String? @db.Text

  createdAt DateTime @default(now())

  @@index([eodReportId])
  @@map("eod_expenses")
}

// ================= CUSTOMER DOCUMENT =================

model CustomerDocument {
  id String @id @default(uuid())

  customerId String

  customer Customer @relation(fields: [customerId], references: [id])

  documentType String @db.VarChar(100)

  fileName String @db.VarChar(255)

  filePath String @db.Text

  uploadedAt DateTime @default(now())

  @@map("customer_documents")
}

// ================= AUDIT LOG =================

model AuditLog {
  id String @id @default(uuid())

  adminId String?

  admin Admin? @relation(fields: [adminId], references: [id])

  action String @db.VarChar(150)

  tableName String @db.VarChar(100)

  recordId String @db.VarChar(100)

  ipAddress String? @db.VarChar(50)

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ================= LOAN SCHEDULE =================

model LoanSchedule {
  id String @id @default(uuid())

  loanId String

  loan Loan @relation(fields: [loanId], references: [id])

  installmentNo Int

  dueDate DateTime

  amount Decimal @db.Decimal(15, 2)

  penalty Decimal @default(0) @db.Decimal(15, 2)

  isPaid Boolean @default(false)

  paidDate DateTime?

  payments Payment[]

  createdAt DateTime @default(now())

  @@map("loan_schedule")
}

// ================= SETTINGS =================

model Setting {
  id String @id @default(uuid())

  companyName    String
  companyPhone   String
  companyEmail   String?
  companyAddress String?
  website        String?
  currency       String  @default("INR")

  receiptPrefix String @default("RCP")

  // Legal & Compliance
  businessType         String?
  registrationNumber   String?
  gstin                String?
  pan                  String?
  rbiLicenseNumber     String?
  dateOfIncorporation  DateTime?

  // Financial Settings
  defaultInterestPercentage Decimal @db.Decimal(5, 2)
  defaultPenaltyPercentage  Decimal @db.Decimal(5, 2)
  financialYearStartMonth   Int     @default(4)
  latePaymentGraceDays      Int     @default(0)

  // Branch Details
  branchName    String?
  branchCode    String?
  branchManager String?
  branchPhone   String?

  // Bank Details
  bankAccountHolderName String?
  bankName              String?
  bankAccountNumber     String?
  bankIfscCode          String?
  bankBranchName        String?
  upiId                 String?

  // Branding
  companyLogo String?
  themeColor  String? @default("#0E6B4F")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id String @id @default(uuid())

  title   String
  message String

  type NotificationType @default(INFO)

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id])

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}
